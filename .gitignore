# Virtual environment
venv/
env/
.venv/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Dataset (too large for git - see README for download instructions)
data/raw/*
!data/raw/.gitkeep
data/cleaned/*
!data/cleaned/.gitkeep
data/split/
data/external_test/*
!data/external_test/.gitkeep
data/quarantine/

# Trained models (large binary artifacts - see README for training instructions)
models/*.keras
models/*.tflite
# keep class_names.json since it's small metadata generated at train time and needed to explain structure
!models/class_names.json

# Reports generated by training/evaluation runs
reports/*
!reports/.gitkeep

# Database
instance/
*.db

# Uploaded user images
uploads/*
!uploads/.gitkeep

# Secrets / env
.env
*.env

# OS / editor
.DS_Store
.vscode/
.idea/
